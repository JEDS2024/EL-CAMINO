; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="El Camino"
config/version="0.13"
config/description="Aventura cristiana 3D en pixel art: fe, esperanza, amor y perdón."
run/main_scene="res://escenas/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

general/text_to_speech=true

[autoload]

Juego="*res://scripts/juego.gd"
Sonido="*res://scripts/sonido.gd"
Actualizador="*res://scripts/actualizaciones/actualizador.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[actualizaciones]

version_code=13
url_versiones="https://github.com/JEDS2024/EL-CAMINO/releases/latest/download/actualizacion.json"
